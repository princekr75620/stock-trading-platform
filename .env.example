# ==============================================================================
# ENVIRONMENT VARIABLES & CONFIGURATION TEMPLATE
# Copy this file to .env for local development ONLY (never commit .env or secrets).
# Node.js loads .env via dotenv/config and passes values to Java; Java also reads
# .env directly via EnvConfig when launched standalone without suppressing OS env.
# ==============================================================================

# ------------------------------------------------------------------------------
# [Node.js] Gateway & Subprocess Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JAVA_HOST=127.0.0.1
JAVA_PORT=8765
JAVA_STARTUP_TIMEOUT_MS=20000
SKIP_JAVA_COMPILE=false
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# [Both: Node.js + Java] Runtime Mode, CORS & Session Security
# ------------------------------------------------------------------------------
# 'development' or 'production' (strict DB/TLS/cookie rules enforced in production)
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TIMEOUT_SECONDS=1800
# Set COOKIE_SECURE=true in production behind HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# [Both: Node.js + Java] Relational Database Engine & Bounded Connection Pool
# ------------------------------------------------------------------------------
# 'sqlite' for local embedded development, or 'mysql' for production
DB_TYPE=sqlite
SQLITE_DB_PATH=data/stock_trading.db

# Bounded JDBC Connection Pool settings (enforced by BoundedConnectionPool)
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
DB_POOL_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_MS=1800000

# ------------------------------------------------------------------------------
# [Both: Node.js + Java] MySQL TLS Configuration (when DB_TYPE=mysql)
# Use a dedicated least-privilege application account (NEVER 'root' in production).
# Production requires DB_SSL_MODE=VERIFY_IDENTITY or VERIFY_CA and strong non-default DB_PASSWORD.
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_trading
DB_USER=stock_app_user
DB_PASSWORD=replace_with_strong_database_password
DB_SSL_MODE=VERIFY_IDENTITY
# Path to CA certificate (.pem/.crt) or truststore (.jks/.p12) for certificate verification:
DB_SSL_CA=
DB_SSL_TRUSTSTORE_TYPE=
DB_SSL_TRUSTSTORE_PASSWORD=

# Legacy MYSQL_* aliases (also supported by Java DBConnection / EnvConfig)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stock_trading
MYSQL_USER=stock_app_user
MYSQL_PASSWORD=replace_with_strong_database_password

# ------------------------------------------------------------------------------
# [Java] First-Boot Production Admin Bootstrap (only used if users table is empty)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Local-only override to allow seeding demo accounts outside development (keep false in prod)
SEED_DEMO_ACCOUNTS=false
