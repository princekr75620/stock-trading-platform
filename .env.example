# ==============================================================================
# ENVIRONMENT VARIABLES & CONFIGURATION TEMPLATE
# Copy this file to .env for local configuration (never commit real credentials)
# ==============================================================================

# Application Port (3000 for web terminal / dev gateway)
PORT=3000

# Authoritative Java REST Engine Port (Internal microservice)
JAVA_PORT=8765

# Relational Database Engine ('sqlite' default, or 'mysql')
DB_TYPE=sqlite

# MySQL Configuration (used when DB_TYPE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stock_trading
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_db_password_here

# APP_URL: Injected automatically in cloud environments
APP_URL="http://localhost:3000"
