# ==============================================================================
# ENVIRONMENT VARIABLES & CONFIGURATION TEMPLATE
# Copy this file to .env for local configuration (never commit .env or secrets)
# ==============================================================================

# Gateway Application Port (Node.js Express Gateway)
PORT=3000

# Internal Authoritative Java Backend Binding (keep 127.0.0.1 in production)
JAVA_HOST=127.0.0.1
JAVA_PORT=8765

# Runtime Environment ('development' or 'production')
APP_ENV=development

# Allowed Browser Origins (comma-separated, e.g., https://trade.example.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session & Cookie Security Settings
SESSION_TIMEOUT_SECONDS=1800
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Relational Database Engine ('sqlite' for local dev/embedded, or 'mysql' for production)
DB_TYPE=sqlite
DB_POOL_SIZE=10

# MySQL Configuration (supports both DB_* and MYSQL_* naming; MYSQL_PASSWORD required when DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_trading
DB_USER=stock_app_user
DB_PASSWORD=replace_with_strong_database_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stock_trading
MYSQL_USER=stock_app_user
MYSQL_PASSWORD=replace_with_strong_database_password

# Production Admin Bootstrap (required only on first production initialization when no admin exists)
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# APP_URL: Public base URL when deployed behind reverse proxy / TLS
APP_URL="http://localhost:3000"
