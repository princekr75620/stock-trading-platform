# ==============================================================================
# ENVIRONMENT VARIABLES & CONFIGURATION TEMPLATE
# Copy this file to .env for local configuration (never commit real credentials)
# ==============================================================================

# Application Port (3000 for web terminal / dev gateway)
PORT=3000

# Authoritative Java REST Engine Port (Internal microservice)
JAVA_PORT=8765

# Relational Database Configuration (MySQL / JDBC)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_trading
DB_USER=root
DB_PASSWORD=your_secure_db_password_here

# JDBC URL connection string (for production deployments)
JDBC_URL=jdbc:mysql://127.0.0.1:3306/stock_trading?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Session Security & Encryption Secret
SESSION_SECRET=change_this_to_a_random_32_byte_secret_key_in_production

# APP_URL: Injected automatically in cloud environments
APP_URL="http://localhost:3000"
