<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Online Stock Trading Platform</display-name>
    <description>GUVI College Evaluation Java Web-Based Project (33 Marks)</description>

    <!-- 1. AUTHENTICATION & AUTHORIZATION FILTER -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- 2. AUTHENTICATION SERVLETS -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/api/auth/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/api/auth/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/api/auth/logout</url-pattern>
    </servlet-mapping>

    <!-- 3. TRADING & MARKET SERVLETS -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StockServlet</servlet-name>
        <servlet-class>servlet.StockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StockServlet</servlet-name>
        <url-pattern>/api/stocks</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BuyStockServlet</servlet-name>
        <servlet-class>servlet.BuyStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuyStockServlet</servlet-name>
        <url-pattern>/api/trades/buy</url-pattern>
        <url-pattern>/api/trade/buy</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SellStockServlet</servlet-name>
        <servlet-class>servlet.SellStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellStockServlet</servlet-name>
        <url-pattern>/api/trades/sell</url-pattern>
        <url-pattern>/api/trade/sell</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PortfolioServlet</servlet-name>
        <servlet-class>servlet.PortfolioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PortfolioServlet</servlet-name>
        <url-pattern>/api/portfolio</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TransactionServlet</servlet-name>
        <servlet-class>servlet.TransactionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TransactionServlet</servlet-name>
        <url-pattern>/api/trades</url-pattern>
        <url-pattern>/api/transactions</url-pattern>
    </servlet-mapping>

    <!-- 4. ADMINISTRATOR SERVLETS -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/api/admin/dashboard</url-pattern>
        <url-pattern>/api/admin/stats</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserManagementServlet</servlet-name>
        <servlet-class>servlet.UserManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserManagementServlet</servlet-name>
        <url-pattern>/api/admin/users</url-pattern>
        <url-pattern>/api/admin/users/update</url-pattern>
        <url-pattern>/api/admin/users/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddStockServlet</servlet-name>
        <servlet-class>servlet.AddStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddStockServlet</servlet-name>
        <url-pattern>/api/admin/stocks/add</url-pattern>
        <url-pattern>/api/admin/stocks</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateStockServlet</servlet-name>
        <servlet-class>servlet.UpdateStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateStockServlet</servlet-name>
        <url-pattern>/api/admin/stocks/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteStockServlet</servlet-name>
        <servlet-class>servlet.DeleteStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteStockServlet</servlet-name>
        <url-pattern>/api/admin/stocks/delete</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
